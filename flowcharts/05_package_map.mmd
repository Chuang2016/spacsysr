    end

    subgraph 过程模块
        SW["soilwater.R\n蓄水桶水平衡"]
        RICH["soilwater_richards.R\nRichards 溶质运移"]
        HEAT["soilheat.R\n土壤热传导"]
        DEC["decomposition.R\n有机质分解"]
        NIT["nitrification.R\n硝化"]
        DEN["denitrification.R\n反硝化"]
        GAS["gaseous.R / volatilization.R\nN2O/NO/NH3"]
        CH4["methane.R\nCH4 产生/氧化"]
        PHO["photosynthesis.R\nFarquhar C3/C4 + 冠层"]
        PLR["plant.R\n呼吸"]
        PLL["plant_lite.R\nRUE 简化生长"]
        RESP["response.R\n温度/水分/pH响应"]
    end

    subgraph 输出层
        O1["产量 / LAI / 生物量"]
        O2["N2O / NO / NH3 / CH4"]
        O3["硝态氮淋溶"]
        O4["土壤水热动态"]
    end

