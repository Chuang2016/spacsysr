\name{spacsys_default_params}
\alias{spacsys_default_params}
\title{Default parameter list}
\description{Starting values for spacsys_run and spacsys_lite_run, drawn from the manual where given and otherwise set as clearly-marked placeholders to calibrate. Includes up_frac_max (lite model only): maximum fraction of root-zone mineral N available for plant uptake per day, default 0.5.}
\usage{spacsys_default_params()}
\value{A named list of parameters.}
\examples{str(spacsys_default_params())}
